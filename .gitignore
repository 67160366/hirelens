# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
.next/
out/
*.tsbuildinfo
# pdf.js's worker, copied out of node_modules by web/scripts/copy-pdf-worker.mjs
# before every dev run and build. Generated, not authored.
web/public/pdf.worker.min.mjs

# Environment / secrets
.env
.env.local
.env.*.local
# The production secrets file. `.env.*.local` above does NOT match it — that
# pattern needs a `.local` suffix — so without this line a file full of prod
# credentials would be committable. `.env.prod.example` is the committed shape.
.env.prod

# Local dev storage (uploaded resumes live here before MinIO lands in M2)
var/
storage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Source material — not code, and may contain third-party content
*.pdf
!api/tests/fixtures/*.pdf
!evals/fixtures/**/*.pdf
# Generated by docs/pitch/sample/generate_sample.py, and committed for the reason
# the fixtures are: rebuilding it needs a Thai-capable system font, which a fresh
# clone will not have. Nobody real appears in it.
!docs/pitch/sample/*.pdf
# docs/pitch/deck.pdf stays ignored on purpose: it is printed from deck.html and
# would land a fresh 2.4 MB blob in history on every edit of the deck.
