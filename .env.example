# Copy to .env and fill in. Never commit .env.

# dev  = local development defaults are accepted
# prod = the API refuses to start on the placeholder JWT_SECRET
APP_ENV=dev

# --- LLM provider ---------------------------------------------------------
# fake      = fixture-backed, no network, no cost. The default for dev and CI.
# gemini    = Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# anthropic = Claude. Paid; see docs/llm-providers.md for cost per application.
LLM_PROVIDER=fake

# Behaviour of the fake provider (see docs/llm-providers.md):
# faithful      = every quote is real (default)
# hallucinating = adds one fabricated claim — the way to demo the dropped-claims UI
# unavailable   = raises, to exercise the backend-down path
FAKE_MODE=faithful

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Datastores ----------------------------------------------------------
# SQLite needs no server and is the dev default. For Postgres, run
# `docker compose up -d` and use the URL below (matches docker-compose.yml).
DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# DATABASE_URL=postgresql+asyncpg://hirelens:hirelens@localhost:5432/hirelens
REDIS_URL=redis://localhost:6379/0

# --- Storage -------------------------------------------------------------
# M1 writes uploads to the local filesystem; M2 swaps in MinIO behind the same
# interface.
STORAGE_BACKEND=local
STORAGE_DIR=var/uploads

# --- Auth ----------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-deploying
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
