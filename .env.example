# Copy to .env and fill in. Never commit .env.

# dev  = local development defaults are accepted
# prod = the API refuses to start on the placeholder JWT_SECRET
APP_ENV=dev

# --- LLM provider ---------------------------------------------------------
# fake      = fixture-backed, no network, no cost. The default for dev and CI.
# gemini    = Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# anthropic = Claude. Paid; see docs/llm-providers.md for cost per application.
LLM_PROVIDER=fake

# Behaviour of the fake provider (see docs/llm-providers.md):
# faithful      = every quote is real (default)
# hallucinating = adds one fabricated claim — the way to demo the dropped-claims UI
# unavailable   = raises, to exercise the backend-down path
FAKE_MODE=faithful

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Datastores ----------------------------------------------------------
# SQLite needs no server, so a fresh clone runs as-is. Postgres is the deployment
# target and what this project develops against day to day: run `docker compose up -d`
# and swap the two lines below (the URL matches docker-compose.yml). Either way the
# test suite uses its own in-memory SQLite and needs no server.
DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# DATABASE_URL=postgresql+asyncpg://hirelens:hirelens@localhost:5432/hirelens
REDIS_URL=redis://localhost:6379/0

# --- Queue ---------------------------------------------------------------
# Where parsing and extraction run. Upload answers `pending` either way and the
# client polls, so this changes the deployment shape, not the API contract.
# inline = run it before the upload responds. No Redis, so a fresh clone works.
#          It cannot defer work, so it never retries a transient failure.
# arq    = hand it to a worker: `docker compose up -d` then `arq app.worker.WorkerSettings`
QUEUE_BACKEND=inline

# Consecutive job failures before a resume is dead-lettered, and the backoff
# between attempts (base * 2 ** (failures - 1): 5s, 10s, 20s).
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5

# --- Storage -------------------------------------------------------------
# M1 writes uploads to the local filesystem; M2 swaps in MinIO behind the same
# interface.
STORAGE_BACKEND=local
STORAGE_DIR=var/uploads

# --- OCR -----------------------------------------------------------------
# Reads pages that have no text layer, so a scanned resume is not a dead end.
# Off by default because Tesseract is a system binary and CI has none — the same
# reason the extractor defaults to `fake`.
# none      = a scan is reported, not read (default)
# tesseract = render the page and recognize it. Needs Tesseract installed.
OCR_ENGINE=none

# The binary's name, or its full path when it is not on PATH — a portable
# Tesseract usually is not. On Windows that often looks like:
#   OCR_COMMAND=C:\Users\you\tesseract.exe
OCR_COMMAND=tesseract

# Tesseract's `+`-joined language codes. A pack that is not installed is refused
# at startup rather than silently returning noise, so check `tesseract --list-langs`.
OCR_LANGUAGES=tha+eng

# Render resolution, and the most pages one document may spend OCR on. Recognition
# costs roughly a second per page, so the cap is what stops a long scan from
# holding a worker.
OCR_DPI=300
OCR_MAX_PAGES=10

# --- Auth ----------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-deploying
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
