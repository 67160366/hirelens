# Copy to .env and fill in. Never commit .env.
#
# `docker compose up -d --build` reads this file too, and passes the values below
# into the containers as environment. Two groups are the exception, because the
# compose file sets them itself and a value here would be ignored:
#
#   * DATABASE_URL / REDIS_URL — inside a container `localhost` is the container,
#     so compose points them at the service names `postgres` and `redis`.
#   * QUEUE_BACKEND / STORAGE_DIR — the stack runs a real worker, and STORAGE_DIR
#     has to be an absolute path inside the image.
#
# The file itself never enters an image; it is read on the host at `up` time.

# dev  = local development defaults are accepted
# prod = the API refuses to start on the placeholder JWT_SECRET
APP_ENV=dev

# --- LLM provider ---------------------------------------------------------
# fake      = fixture-backed, no network, no cost. The default for dev and CI.
# gemini    = Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# anthropic = Claude. Paid; see docs/llm-providers.md for cost per application.
LLM_PROVIDER=fake

# Behaviour of the fake provider (see docs/llm-providers.md):
# faithful      = every quote is real (default)
# hallucinating = adds one fabricated claim — the way to demo the dropped-claims UI
# unavailable   = raises, to exercise the backend-down path
FAKE_MODE=faithful

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Datastores ----------------------------------------------------------
# SQLite needs no server, so a fresh clone runs as-is. Postgres is the deployment
# target and what this project develops against day to day: run `docker compose up -d`
# and swap the two lines below (the URL matches docker-compose.yml). Either way the
# test suite uses its own in-memory SQLite and needs no server.
DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# DATABASE_URL=postgresql+asyncpg://hirelens:hirelens@localhost:5432/hirelens
REDIS_URL=redis://localhost:6379/0

# --- Queue ---------------------------------------------------------------
# Where parsing and extraction run. Upload answers `pending` either way and the
# client polls, so this changes the deployment shape, not the API contract.
# inline = run it before the upload responds. No Redis, so a fresh clone works.
#          It cannot defer work, so it never retries a transient failure.
# arq    = hand it to a worker: `docker compose up -d` then `arq app.worker.WorkerSettings`
QUEUE_BACKEND=inline

# Consecutive job failures before a resume is dead-lettered, and the backoff
# between attempts (base * 2 ** (failures - 1): 5s, 10s, 20s).
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5

# How long a row may sit at `processing` before the worker holding it is presumed
# dead and it is reclaimed — a worker that is killed never gets to fail, so
# nothing else would ever move that row. The sweep runs on the arq worker once a
# minute; under `inline` there is no worker, and `POST /resumes/{id}/retry` on a
# stalled row is the way back instead.
#
# It has to cover the slowest *whole* job, because the claim is written once and
# never heartbeats — reaping a worker that is merely slow duplicates its work.
JOB_VISIBILITY_TIMEOUT_SECONDS=900

# --- Storage -------------------------------------------------------------
# Where uploaded resumes are kept. Both are real deployments and nothing above
# app/storage.py can tell them apart.
# local = the filesystem under STORAGE_DIR. No server, so a fresh clone works.
# minio = object storage over the S3 API: `docker compose up -d` runs one, and
#         creates the bucket in its own one-shot service. A missing bucket is
#         refused at startup rather than discovered on the first upload.
STORAGE_BACKEND=local
STORAGE_DIR=var/uploads

# Only read when STORAGE_BACKEND=minio. These defaults match docker-compose.yml,
# so on this machine turning it on is one variable. In Docker leave the endpoint
# alone: compose sets it to the service name, since `localhost` inside a container
# is the container. The console is at http://localhost:9001.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=hirelens
MINIO_SECRET_KEY=hirelens-dev-secret
MINIO_BUCKET=hirelens-resumes

# --- OCR -----------------------------------------------------------------
# Reads pages that have no text layer, so a scanned resume is not a dead end.
# Off by default because Tesseract is a system binary and CI has none — the same
# reason the extractor defaults to `fake`.
# none      = a scan is reported, not read (default)
# tesseract = render the page and recognize it. Needs Tesseract installed.
OCR_ENGINE=none

# The binary's name, or its full path when it is not on PATH — a portable
# Tesseract usually is not. On Windows that often looks like:
#   OCR_COMMAND=C:\Users\you\tesseract.exe
# In Docker leave this alone: the API image installs tesseract with `tha` and `eng`
# on PATH, so OCR_ENGINE=tesseract is the only setting needed there.
OCR_COMMAND=tesseract

# Tesseract's `+`-joined language codes. A pack that is not installed is refused
# at startup rather than silently returning noise, so check `tesseract --list-langs`.
OCR_LANGUAGES=tha+eng

# Render resolution, and the most pages one document may spend OCR on. Recognition
# costs roughly a second per page, so the cap is what stops a long scan from
# holding a worker.
OCR_DPI=300
OCR_MAX_PAGES=10

# Least mean per-word confidence (0-100) a recognized page may have before it is
# refused. This is what stops a badly degraded scan from *succeeding with nonsense*:
# a blurred page still yields plenty of characters, they are simply the wrong ones,
# and a character count cannot tell text from noise.
#
# 75 was measured rather than guessed — `python tests/tools/ocr_degradation.py`
# degrades the scanned fixture sixteen ways: everything that still yielded its
# content scored 90+ and everything that yielded none scored under 50.
# 0 turns the check off, and with it the second Tesseract call it costs.
OCR_MIN_CONFIDENCE=75

# --- Retrieval -----------------------------------------------------------
# Which resumes are worth *paying* to judge. This only orders a list — it makes
# no claim about anyone and never decides what evidence a screening sees, which
# is why it is the one part of the pipeline allowed to be approximate.
# lexical  = scored in memory from text already in the database (default). Needs
#            no server and no embedding provider, so a fresh clone and the test
#            suite are unchanged — the same reasoning as LLM_PROVIDER=fake and
#            OCR_ENGINE=none.
# pgvector = refused at startup. Embeddings are a paid call, so this adapter
#            lands only with a price table and a recorded live run, exactly as
#            LLM_PROVIDER=anthropic does.
RETRIEVAL_BACKEND=lexical

# --- Auth ----------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-deploying
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# The browser signs in with httpOnly cookies carrying the same tokens; scripts and
# every curl in docs/RUNBOOK.md still use a Bearer header, and both work. These two
# settings govern the cookies, and the defaults are the ones a fresh clone can run.
#
# `Secure` means the cookie is only sent over HTTPS. False here because dev is plain
# http — though note Chrome treats http://localhost as a secure context, so `true`
# works there too. Any real deployment sets it.
COOKIE_SECURE=false

# How far the browser will carry the session, and this is the CSRF control rather
# than a preference: a cookie is attached whatever page asked for it, which a Bearer
# header is not.
# lax    = same-site requests and top-level navigations only (default). Sufficient
#          whenever the page and the API share a host — and note cookies ignore
#          ports, so localhost:3000 -> localhost:8000 is same-site while
#          127.0.0.1:3000 -> localhost:8000 is NOT, and the cookie is withheld.
# strict = also withheld from navigations into the app, so an emailed link lands
#          on a signed-out page.
# none   = sent cross-site, for a browser and an API on different domains. Throws
#          away the protection above, leaving the Origin check in api/app/api/deps.py
#          as the only thing between a cookie and a forged write. Requires
#          COOKIE_SECURE=true — the API refuses to start without it, because
#          browsers drop that cookie outright.
COOKIE_SAMESITE=lax
