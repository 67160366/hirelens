# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---------------------------------------------------------
# fake      = fixture-backed, no network, no cost. The default for dev and CI.
# gemini    = Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# anthropic = Claude. Paid; see docs/llm-providers.md for cost per application.
LLM_PROVIDER=fake

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Datastores ----------------------------------------------------------
# Matches docker-compose.yml. Override the host if you point at a cloud Postgres.
DATABASE_URL=postgresql+asyncpg://hirelens:hirelens@localhost:5432/hirelens
REDIS_URL=redis://localhost:6379/0

# --- Storage -------------------------------------------------------------
# M1 writes uploads to the local filesystem; M2 swaps in MinIO behind the same
# interface.
STORAGE_BACKEND=local
STORAGE_DIR=var/uploads

# --- Auth ----------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-deploying
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
