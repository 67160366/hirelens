# Copy to .env.prod and fill in. `.env.prod` is gitignored; never commit it.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# This file is read by compose's own `${VAR}` substitution, which is what reaches
# the `${VAR:-default}` expressions already written into docker-compose.yml.
# A service-level `env_file:` would NOT work here and it is worth knowing why:
# measured on Compose v5.3.1, a base file's `environment:` key beats an override's
# `env_file:`, so every secret below would silently keep its dev default.
#
# Values with no default are marked REQUIRED — compose refuses to start the whole
# project if one is missing, rather than falling back to a development credential.
#
# See docs/RUNBOOK.md for what to do with this file, and how to rotate any of it.

# --- Identity of the deployment ------------------------------------------
# Set by docker-compose.prod.yml, not here. Recorded for the reader: APP_ENV=prod
# makes api/app/config.py refuse to start on the placeholder JWT_SECRET below, and
# the migrate service runs under it too, so a forgotten secret fails at the first
# service rather than the third.

# --- Secrets — REQUIRED --------------------------------------------------
# Generate each one separately:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Signs every access and refresh token. There is no way to revoke tokens signed
# with an old one (the refresh-token denylist is not built), so rotating this
# logs everybody out at the next request, which is the intended blunt instrument.
JWT_SECRET=

# The Postgres superuser password. The database is not published to the host in
# prod, but this also travels inside DATABASE_URL, so it is a real secret.
POSTGRES_PASSWORD=

# MinIO's root credentials. The API and worker authenticate with these as their
# S3 access key and secret; docker-compose.prod.yml wires them to both.
# Only load-bearing when STORAGE_BACKEND=minio, but required either way so that
# flipping that variable never needs a second trip through this file.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Provider ------------------------------------------------------------
# fake = fixture-backed, no network, no cost. Deliberately still the default:
# a stack that comes up on `gemini` starts spending a quota nobody authorised.
LLM_PROVIDER=fake
FAKE_MODE=faithful
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Storage -------------------------------------------------------------
# local = the uploads volume. minio = the object store in this compose project.
STORAGE_BACKEND=local
MINIO_BUCKET=hirelens-resumes

# --- Where the browser reaches the API -----------------------------------
# NEXT_PUBLIC_API_BASE is a BUILD ARG: `next build` inlines it into the client
# bundle. Changing it means `up -d --build web`, not a restart — and CORS_ORIGINS
# below has to name the same origin or every request fails preflight.
NEXT_PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Host ports ----------------------------------------------------------
# Both are bound to 127.0.0.1 by docker-compose.prod.yml; a reverse proxy on the
# host is what faces the network. Override them to rehearse this stack alongside a
# running dev stack without colliding — see docs/RUNBOOK.md.
API_PORT=8000
WEB_PORT=3000

# --- Jobs ----------------------------------------------------------------
# How long a row may sit at `processing` before the worker holding it is presumed
# dead. It must cover the slowest whole job, because the claim never heartbeats.
JOB_VISIBILITY_TIMEOUT_SECONDS=900

# --- OCR -----------------------------------------------------------------
# The API image ships Tesseract with `tha` and `eng` on PATH, so turning it on is
# this one variable — no OCR_COMMAND path needed inside a container.
OCR_ENGINE=none
OCR_LANGUAGES=tha+eng
