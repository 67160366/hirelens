# Set these in Render's dashboard; never commit a file containing actual secrets.
# Session pooler, port 5432, with URL-encoded password. Remove sslmode query params:
# DATABASE_SSL=true supplies verified TLS to both the API and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=/app/certs/supabase-prod-ca-2021.crt
DATABASE_SCHEMA=hirelens
APP_ENV=prod
QUEUE_BACKEND=database
STORAGE_BACKEND=minio
MINIO_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
MINIO_REGION=ap-southeast-1
MINIO_BUCKET=hirelens-resumes
MINIO_ACCESS_KEY=YOUR_SERVER_ONLY_S3_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_SERVER_ONLY_S3_SECRET_KEY
JWT_SECRET=GENERATE_A_RANDOM_SECRET
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH_PREFIX=/api
CORS_ORIGINS=https://YOUR_PROJECT.vercel.app
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_EXISTING_FREE_TIER_KEY
GEMINI_MODEL=YOUR_EXISTING_WORKING_FREE_TIER_MODEL
OCR_ENGINE=tesseract
OCR_LANGUAGES=tha+eng
